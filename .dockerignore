# Build artifacts — never send to Docker daemon
build/

# Test data — downloaded from GitHub release during docker build
data/

# reelay subproject — cloned fresh from GitHub during docker build
reelay/

# Git metadata — expose only enough information to resolve HEAD automatically.
# Object data, configuration, hooks, logs, and the index stay out of the context.
.git/*
!.git/HEAD
!.git/packed-refs
!.git/refs/
!.git/refs/**

# Docker infrastructure files (no need to COPY these into the image)
Dockerfile
.dockerignore

# Compiled object files and static libraries
*.o
*.a

# Python caches
__pycache__/
*.pyc
*.pyo

# macOS metadata
.DS_Store
